# Ten — copy to .env: cp .env.example .env
#
# Auto-loaded (via dotenv) by:
#   npm run start
#   npm run google:check
#   npm run deepl:check
#   npm run import:anki
#
# Not read from .env: npm run generate:pt, npm run generate:fr, npm run frequency:download

# --- Required for Translate (npm run start) ---

# Google Cloud Translation — used for 1–5 word inputs
GOOGLE_TRANSLATE_API_KEY=

# DeepL API Free — used for 6+ word inputs
DEEPL_AUTH_KEY=

# --- Server (optional) ---

# HTTP port (default 3001; scans upward if busy)
# PORT=3001

# SQLite database (default data/ten.db — unlocks, daily progress, flashcards)
# TEN_DB_PATH=data/ten.db

# --- API endpoint overrides (optional; defaults are fine for almost everyone) ---

# DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2

# --- One-time / maintenance scripts (optional) ---

# npm run import:anki — AnkiConnect on the machine running Anki Desktop
# ANKI_CONNECT_ENDPOINT=http://127.0.0.1:8765

# npm run generate:fr — export in shell before running; does not load .env
# FR_TARGET_WORDS=100
# FR_SKIP_TOP_N=0
