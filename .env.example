# Copy to .env and fill in values: cp .env.example .env
# The server loads this automatically via dotenv (npm run start).

# --- Server (required for translate + card storage) ---

# HTTP port (default 3001; server scans upward if the port is in use)
PORT=3001

# Google Cloud Translation API key (1–5 word inputs)
GOOGLE_TRANSLATE_API_KEY=

# DeepL API Free auth key (6+ word inputs)
DEEPL_AUTH_KEY=

# SQLite path (default: data/ten.db — unlocks, daily progress, flashcards)
# TEN_DB_PATH=

# One-time Anki import only (npm run import:anki) — needs Anki Desktop + AnkiConnect running
# ANKI_CONNECT_ENDPOINT=http://127.0.0.1:8765

# --- Optional API overrides ---

# DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2

# --- French word generator (npm run generate:fr) ---

# FR_TARGET_WORDS=100
# FR_SKIP_TOP_N=0
